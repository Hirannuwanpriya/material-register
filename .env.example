DATABASE_URL=postgres://materials:materials@localhost:5432/material_register
PORT=3001

# Copy to api/.env and adjust if needed:  cp .env.sample .env

# Postgres connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Must match docker-compose.yml. Host port 5433 so this project can run
# next to the hand-built one on 5432.j
DATABASE_URL=postgres://materials:materials@localhost:5433/material_register

# Port the API listens on
PORT=3001

# The only browser origin allowed to call the API (CORS). Must match the web dev server.
WEB_ORIGIN=http://localhost:5173

# How many materials the seed script creates (brief asks for at least 5,000)
SEED_COUNT=20000



# Copy to web/.env if you need to change it:  cp .env.sample .env
# Optional: without it the app uses http://localhost:3001/trpc

# tRPC endpoint of the API. Only variables starting with VITE_ reach the browser.
VITE_API_URL=http://localhost:3001/trpc
